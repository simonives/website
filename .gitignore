# =============================================================
#  .gitignore — simonives.com
#  Static HTML/CSS/JS site hosted on GitHub Pages
# =============================================================

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# --- Windows ---
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Linux ---
*~

# --- Editors & IDEs ---
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.cursor/
*.code-workspace

# --- Node (if build tools are ever used locally) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm

# --- Environment & secrets ---
.env
.env.local
.env.*.local

# --- Logs ---
*.log

# --- Private planning documents ---
# These files are local only and must never be published.
PROJECT_PLAN.md
STYLE_GUIDE.md

# --- AI collaboration files ---
# Working documents for AI-assisted development. Not needed in the public repo view.
CLAUDE.md

# --- Development & testing artifacts ---
# These files are local development artefacts and should not
# be committed to the repository.
backend_payload.txt
*.bak
*.orig

# --- Archive / temp files ---
*.zip
*.tar.gz
*.rar
